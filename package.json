{
	"name": "kids-games",
	"version": "0.0.0",
	"description": "Educational browser games for young children. iPad first, works offline.",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --port 4173 --strictPort",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"e2e": "playwright test",
		"shots": "playwright test --project=ipad-webkit --grep @shot",
		"icons": "pwa-assets-generator",
		"verify": "npm run lint && npm run typecheck && npm test && npm run e2e",
		"ideas": "node scripts/ideas.ts",
		"review-grades": "node scripts/review-grades.ts"
	},
	"license": "MIT",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@playwright/test": "^1.65.1",
		"@types/node": "^26.6.6",
		"@vite-pwa/assets-generator": "^2.0.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.1.1"
	},
	"private": true,
	"engines": {
		"node": ">=24"
	}
}
