{
	"name": "kids-games",
	"version": "0.0.0",
	"description": "Educational browser games for young children. iPad first, works offline.",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --port 4173 --strictPort",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"e2e": "playwright test",
		"shots": "playwright test --project=ipad-webkit --grep @shot"
	},
	"license": "MIT",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@playwright/test": "^1.65.1",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"private": true
}
